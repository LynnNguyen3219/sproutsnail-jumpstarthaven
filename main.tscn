[sub_resource type="GDScript" id="GDScript_lquwl"]
script/source = "extends Node

@export var health : Array[Node]

var lives = 3

func decrease_health():
	lives -= 1
	print(lives)
	for h in 3:
		if (h < lives):
			health[h].show()
		else:
			health[h].hide()

		get_tree().reload_current_scene()
"

